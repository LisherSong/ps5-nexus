# ---- build outputs -------------------------------------------------------
# Artifact names carry $(VERSION_TAG), so match the stem rather than a version.
gen/
PS5-Nexus-*.elf
PS5-Nexus-linux-*
PS5-Nexus-asan
linux-obj/
ps5-obj/
*.o
*.d

# ---- local scratch -------------------------------------------------------
# Host-test sandboxes, fixtures, backups and screenshots. Never publish: the
# backups alone are tens of MB and they contain point-in-time copies of src/.
.build/

# ---- pre-rename artifacts -----------------------------------------------
# Kept listed so an old binary lying around cannot be mistaken for a fresh
# build (a stale NEXUS.elf is exactly how "the update did nothing" happens).
NEXUS.elf
NEXUS-linux
NEXUS-asan
web-file-mgr.elf
web-file-mgr-linux
